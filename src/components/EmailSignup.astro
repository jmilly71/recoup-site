---
/**
 * Email signup pill: a real email field with ghost copy plus a Get notified
 * button, in every state.
 * - With `site.emailSignupEndpoint` set, the form POSTs there in a new tab, so
 *   the visitor keeps their place on the landing page.
 * - With it null, the form is a no-JS-safe mailto (method post + text/plain),
 *   and the inline script upgrades that to a pre-filled email including the
 *   typed address. Either way the button always does something useful.
 */
import { site } from '../config';

interface Props {
  caption?: string;
}
const { caption } = Astro.props;

const hasEndpoint = Boolean(site.emailSignupEndpoint);
const mailtoAction = `mailto:${site.supportEmail}?subject=${encodeURIComponent(
  'Notify me when Rēcoup launches'
)}`;
---

<div class="signup-block">
  <form
    class="signup"
    method="post"
    action={hasEndpoint ? site.emailSignupEndpoint : mailtoAction}
    enctype={hasEndpoint ? undefined : 'text/plain'}
    target={hasEndpoint ? '_blank' : undefined}
    rel={hasEndpoint ? 'noopener' : undefined}
    data-mailto={hasEndpoint ? undefined : mailtoAction}
  >
    {hasEndpoint && site.emailSignupTag && (
      <input type="hidden" name="tag" value={site.emailSignupTag} />
    )}
    <input
      type="email"
      name="email"
      required
      placeholder="Enter email address"
      aria-label="Email address"
      autocomplete="email"
    />
    <button class="signup-btn" type="submit">Get notified</button>
  </form>
  {caption && <p class="signup-caption muted">{caption}</p>}
</div>

<script>
  // No endpoint configured: enrich the mailto with the typed address. The form
  // already has a working no-JS mailto action, so this only improves it.
  document.querySelectorAll<HTMLFormElement>('form.signup[data-mailto]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = new FormData(form).get('email');
      location.href =
        form.dataset.mailto +
        '&body=' +
        encodeURIComponent(`Please add ${email} to the launch list.`);
    });
  });
</script>

<style>
  .signup-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
  }

  .signup {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.35rem 0.35rem 1.35rem;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--hairline-soft);
    box-shadow: 0 10px 30px -14px rgba(20, 23, 28, 0.25);
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  .signup input {
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
    width: min(15em, 42vw);
    padding-block: 0.55em;
  }

  .signup input::placeholder {
    color: var(--muted);
  }

  .signup input:focus {
    outline: none;
  }

  /* Clear keyboard focus indicator on the whole pill (the input's own outline
     is suppressed above for looks). */
  .signup:focus-within {
    border-color: var(--green);
    box-shadow: 0 10px 30px -14px rgba(20, 23, 28, 0.25), 0 0 0 3px var(--green-soft);
  }

  .signup-btn {
    display: inline-flex;
    justify-content: center;
    border: 0;
    cursor: pointer;
    font: inherit;
    font-weight: 640;
    font-size: 0.98rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: 999px;
    padding: 0.68em 1.35em;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 140ms ease;
  }

  .signup-btn:hover {
    opacity: 0.88;
  }

  .signup-caption {
    font-size: 0.9rem;
  }

  @media (max-width: 480px) {
    .signup {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      max-width: 22rem;
      padding: 0.8rem;
      gap: 0.6rem;
      border-radius: 1.7rem;
    }

    .signup input {
      width: 100%;
      min-width: 0;
      text-align: center;
      padding-block: 0.3em;
    }
  }
</style>
