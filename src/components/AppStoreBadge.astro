---
/**
 * "Download on the App Store" badge, drawn as inline SVG so it ships inside the
 * HTML with no separate image request (raster badge files get dropped by some
 * SSL-inspection proxies). Shown only once `launchState` flips to 'launched'
 * and `site.appStoreUrl` is set. At launch, swap this for Apple's official
 * badge artwork if you prefer the exact mark; the link target stays the same.
 */
interface Props {
  url: string;
}
const { url } = Astro.props;
---

<a class="appstore-badge" href={url} aria-label={`Download Rēcoup on the App Store`}>
  <svg viewBox="0 0 120 40" role="img" aria-hidden="true" focusable="false">
    <rect width="120" height="40" rx="8.5" fill="currentColor"></rect>
    <g fill="var(--paper)">
      <path
        d="M26.6 20.4c-.03-2.9 2.37-4.28 2.48-4.35-1.35-1.98-3.46-2.25-4.2-2.27-1.79-.18-3.49 1.05-4.4 1.05-.9 0-2.3-1.03-3.78-1-1.95.03-3.74 1.13-4.74 2.87-2.02 3.51-.52 8.7 1.44 11.55.96 1.4 2.11 2.96 3.62 2.9 1.45-.06 2-.93 3.76-.93 1.74 0 2.25.93 3.78.9 1.56-.03 2.55-1.42 3.5-2.82 1.1-1.61 1.56-3.18 1.58-3.26-.03-.02-3.03-1.17-3.06-4.63z"
      ></path>
      <path
        d="M23.73 12c.8-.98 1.34-2.33 1.19-3.69-1.15.05-2.58.78-3.41 1.74-.73.85-1.38 2.24-1.2 3.55 1.29.1 2.61-.65 3.42-1.6z"
      ></path>
    </g>
    <g fill="var(--paper)" font-family="ui-sans-serif, system-ui, sans-serif">
      <text x="39" y="16.5" font-size="6.2" letter-spacing="0.02em">Download on the</text>
      <text x="38.4" y="30" font-size="12.5" font-weight="600" letter-spacing="-0.01em">App Store</text>
    </g>
  </svg>
</a>

<style>
  .appstore-badge {
    display: inline-block;
    width: 165px;
    max-width: 62vw;
    color: var(--ink);
    border-radius: 8.5px;
    transition: transform 140ms ease, opacity 140ms ease;
  }

  .appstore-badge:hover {
    transform: translateY(-1px);
    opacity: 0.9;
  }

  .appstore-badge svg {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
