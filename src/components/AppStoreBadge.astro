---
/**
 * "Download on the App Store" badge using Apple's official artwork, inlined
 * verbatim so it ships inside the HTML with no separate image request (some
 * SSL-inspection proxies drop external badge files). Neither lockup is redrawn
 * or recolored: the US (en-US) black lockup shows on light surfaces and
 * Apple's white lockup (white face, black keyline and text, made for dark
 * backgrounds) shows on dark ones. The swap follows the OS setting and honors
 * an explicit data-theme override, same as the app screenshots. Shown only
 * once `launchState` is 'launched' and `site.appStoreUrl` is set.
 *
 * At 165px wide the badge stands about 55px tall, above Apple's 40px web
 * minimum, and the layouts around it keep more than the quarter-height clear
 * space Apple asks for.
 */
import badgeBlack from '../assets/app-store-badge.svg?raw';
import badgeWhite from '../assets/app-store-badge-white.svg?raw';

interface Props {
  url: string;
}
const { url } = Astro.props;
---

<a class="appstore-badge" href={url} aria-label="Download Rēcoup on the App Store">
  <span class="appstore-badge-art badge-light" aria-hidden="true" set:html={badgeBlack}></span>
  <span class="appstore-badge-art badge-dark" aria-hidden="true" set:html={badgeWhite}></span>
</a>

<style>
  .appstore-badge {
    display: inline-block;
    border-radius: 8.5px;
    transition: transform 140ms ease, opacity 140ms ease;
  }

  .appstore-badge:hover {
    transform: translateY(-1px);
    opacity: 0.9;
  }

  .appstore-badge-art {
    display: block;
    width: 165px;
    max-width: 62vw;
  }

  .appstore-badge-art :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Theme-matched lockup: black on light surfaces, Apple's white lockup on
     dark. Follows the OS and honors the explicit data-theme toggle. */
  .badge-dark {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    .badge-light {
      display: none;
    }
    .badge-dark {
      display: block;
    }
  }
  :global(:root[data-theme='dark']) .badge-light {
    display: none;
  }
  :global(:root[data-theme='dark']) .badge-dark {
    display: block;
  }
  :global(:root[data-theme='light']) .badge-light {
    display: block;
  }
  :global(:root[data-theme='light']) .badge-dark {
    display: none;
  }
</style>
