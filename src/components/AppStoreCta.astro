---
/**
 * The App Store call-to-action.
 * - `site.appStoreUrl` unset (current state): a quiet "coming soon" pill,
 *   plus a TestFlight line (linked if `site.testFlightUrl` is set).
 * - `site.appStoreUrl` set: a Download-on-the-App-Store badge.
 *   Consider swapping in Apple's official badge artwork at that point
 *   (see recoup-site/README.md).
 */
import { site } from '../config';
---

<div class="cta">
  {
    site.appStoreUrl ? (
      <a class="badge" href={site.appStoreUrl}>
        <svg viewBox="0 0 814 1000" aria-hidden="true" fill="currentColor">
          <path d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z" />
        </svg>
        <span class="badge-text">
          <span class="badge-small">Download on the</span>
          <span class="badge-big">App Store</span>
        </span>
      </a>
    ) : (
      <p class="soon">
        <span class="dot" aria-hidden="true" />
        Coming soon to the App&nbsp;Store
      </p>
    )
  }
  <p class="beta muted">
    {
      site.testFlightUrl ? (
        <a href={site.testFlightUrl}>Join the beta on TestFlight →</a>
      ) : (
        'Now in beta on TestFlight.'
      )
    }
  </p>
</div>

<style>
  .cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
  }

  :global(.cta-center) .cta {
    align-items: center;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    background: #000;
    color: #fff;
    border: 1px solid #86867f;
    border-radius: 12px;
    padding: 0.62em 1.35em;
    text-decoration: none;
    transition: transform 140ms ease;
  }

  .badge:hover {
    transform: translateY(-1px);
  }

  .badge svg {
    width: 1.75em;
    height: auto;
  }

  .badge-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    text-align: left;
  }

  .badge-small {
    font-size: 0.72rem;
    font-weight: 480;
  }

  .badge-big {
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .soon {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 0.72em 1.4em;
    font-weight: 640;
    font-size: 1rem;
  }

  .dot {
    width: 0.55em;
    height: 0.55em;
    border-radius: 999px;
    background: var(--green);
    flex: none;
  }

  .beta {
    font-size: 0.92rem;
  }

  .beta a {
    color: var(--ink);
    text-decoration-color: var(--hairline);
    text-underline-offset: 3px;
  }

  .beta a:hover {
    text-decoration-color: var(--green);
  }
</style>
